# =============================================================
# H28K 摄像头网关 配置模板
#   复制成 config.env 后修改，然后 sudo bash install.sh
# =============================================================

# ---------- 云服务器（已装 frps）----------
VPS_ADDR=1.2.3.4
VPS_TOKEN=CHANGE_ME_FRP_TOKEN
VPS_CTRL_PORT=7000

# ---------- 中文台登录（表单登录，浏览器刷新即登出）----------
WEB_USER=admin
WEB_PASS=CHANGE_ME_强密码

# ---------- 摄像头/NVR 账号（所有 NVR 共用；不一致的改生成后的 yaml）----------
NVR_USER=admin
NVR_PASS=CHANGE_ME_NVR密码

# ---------- 对外端口（云安全组要放行下面这三个）----------
PORT_GO2RTC=11984        # go2rtc 原版界面
PORT_CAMWEB=11985        # 中文监控台
PORT_SSH=12222           # 外网 SSH：ssh root@VPS -p 12222

PORT_WEB_BASE=18443      # NVR 网页映射起始端口，依次 +1
PORT_SDK_BASE=18000      # NVR 手机 App(SDK) 起始端口，依次 +1
PORT_RTSP_BASE=18554     # NVR RTSP 映射起始端口，依次 +1
KEEP_NVR_TUNNELS=1       # 1=同时保留 NVR 的 web/sdk/rtsp 映射；0=只要监控画面

# 1=用 PROXY Protocol 拿访客真实 IP（frps >= 0.53 才支持）
# 若部署后发现公网打不开，install.sh 会自动回退到 0
PROXY_PROTOCOL=1

# ---------- 每台 NVR 一行 ----------
# 格式： NVR<n>="IP|显示名|通道列表|通道名(与通道一一对应，可留空)"
# 通道号就是 NVR 里的通道序号，程序自动拼 Streaming/Channels/<通道>02（子码流）
NVR1="192.168.1.64|一号机|1,2,3,4|门口,车间,仓库,走廊"
# NVR2="192.168.1.35|二号机|1,2,3,4,5|前门,后门,流水线,质检,打包"
